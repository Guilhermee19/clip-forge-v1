# ==========================================================================
# ClipForge - Configuracao de ambiente
# Copie este arquivo para `.env` na raiz do projeto e ajuste os valores.
# ==========================================================================

# --------------------------------------------------------------------------
# Diretorios (relativos a raiz do projeto, ou absolutos)
# --------------------------------------------------------------------------
OUTPUT_DIR=output
CLIPS_DIR=output/clips
CACHE_DIR=output/cache
TRANSCRIPTS_DIR=output/transcripts
UPLOADS_DIR=output/uploads

# --------------------------------------------------------------------------
# Transcricao (faster-whisper)
# --------------------------------------------------------------------------
# tiny | base | small | medium | large-v3 | distil-large-v3
# Com 8-12 GB de VRAM: "large-v3" em int8_float16. Com 6 GB: "medium".
WHISPER_MODEL=large-v3
# cuda | cpu | auto
WHISPER_DEVICE=auto
# float16 (mais rapido) | int8_float16 (economiza VRAM) | int8 (CPU)
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=pt
# Numero de segmentos decodificados em paralelo. 1 = menor uso de VRAM.
WHISPER_BEAM_SIZE=5
# VAD remove silencios antes de transcrever (mais rapido e mais preciso)
WHISPER_VAD_FILTER=true

# --------------------------------------------------------------------------
# LLM - selecao de trechos virais
# --------------------------------------------------------------------------
# ollama | gemini | heuristic
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
# llama3.1:8b-instruct-q4_K_M | phi3:medium | mistral:7b-instruct-q4_K_M
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# Janela de contexto. 8192 cabe ~1h de transcricao resumida em 16 GB de RAM.
OLLAMA_NUM_CTX=8192

# --- Gemini (API externa opcional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --------------------------------------------------------------------------
# Selecao de cortes
# --------------------------------------------------------------------------
MIN_CLIPS=5
MAX_CLIPS=12
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=75
# Peso do score de energia do audio (risadas/gritos) na nota final. 0.0 - 1.0
AUDIO_ENERGY_WEIGHT=0.25

# --------------------------------------------------------------------------
# Reframe 9:16 (MediaPipe)
# --------------------------------------------------------------------------
# Quantos frames por segundo sao amostrados para detectar rostos.
REFRAME_SAMPLE_FPS=5
# Fator do filtro exponencial (0-1). Menor = camera mais suave/lenta.
REFRAME_SMOOTHING=0.12
# Zona morta em fracao da largura: a camera so anda se o alvo sair dela.
REFRAME_DEADZONE=0.06
# auto | single | split | center
REFRAME_MODE=auto
# Confianca minima da deteccao de rosto do MediaPipe
REFRAME_MIN_CONFIDENCE=0.5

# --------------------------------------------------------------------------
# Renderizacao (FFmpeg + NVENC)
# --------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# h264_nvenc | hevc_nvenc | libx264 (fallback CPU)
VIDEO_ENCODER=h264_nvenc
# p1 (rapido) ... p7 (melhor qualidade). Usado apenas pelo NVENC.
NVENC_PRESET=p5
# Qualidade alvo do modo CQ do NVENC (menor = melhor). 19-25 e uma boa faixa.
NVENC_CQ=21
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
AUDIO_BITRATE=192k
BURN_SUBTITLES=true

# --------------------------------------------------------------------------
# Legendas (.ass animado palavra-a-palavra)
# --------------------------------------------------------------------------
SUBTITLE_FONT=Montserrat
SUBTITLE_FONT_SIZE=84
# &HBBGGRR& - formato ASS (BGR, nao RGB)
SUBTITLE_PRIMARY_COLOR=&H00FFFFFF
SUBTITLE_HIGHLIGHT_COLOR=&H0000E5FF
SUBTITLE_OUTLINE_COLOR=&H00000000
SUBTITLE_MAX_WORDS_PER_LINE=4
# Distancia da legenda ate a base do video, em pixels
SUBTITLE_MARGIN_V=420

# --------------------------------------------------------------------------
# API / Servidor
# --------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Quantos jobs de video processam ao mesmo tempo. 1 e o recomendado (VRAM).
MAX_CONCURRENT_JOBS=1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------
# Download (yt-dlp)
# --------------------------------------------------------------------------
# Formato do yt-dlp, com fallbacks em cascata separados por `/`.
# Preferimos avc1 (H.264): o OpenCV/MediaPipe decodificam bem e a GPU tem
# decodificacao por hardware, o que nem sempre vale para AV1/VP9.
YTDLP_FORMAT=bestvideo[height<=1080][vcodec^=avc1]+bestaudio[ext=m4a]/bestvideo[height<=1080]+bestaudio/best[height<=1080]/best
# Caminho para um arquivo cookies.txt (necessario para alguns videos)
YTDLP_COOKIES=

LOG_LEVEL=INFO
